<?xml version="1.0" ?>
<robot name="drawer_ur5_inspire">
  <link name="cabinet">
    <inertial>
      <origin xyz="0.12 0 -0.08"/>
      <mass value="2"/>
      <inertia ixx="0.015066666666666666" iyy="0.006733333333333334" izz="0.021666666666666667" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0.12 0 -0.08"/>
      <geometry>
        <box size="0.20 0.30 0.02"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.12 0 -0.08"/>
      <geometry>
        <box size="0.20 0.30 0.02"/>
      </geometry>
    </collision>
  </link>
  <link name="drawer">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0024" iyy="0.0004933333333333334" izz="0.0019333333333333331" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.02 0.24 0.12"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.02 0.24 0.12"/>
      </geometry>
    </collision>
  </link>
  <joint name="slide" type="prismatic">
    <parent link="cabinet"/>
    <child link="drawer"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.16" effort="30" velocity="0.5"/>
  </joint>
  <link name="handle">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="3.75625e-05" iyy="3.125e-06" izz="3.75625e-05" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.025 0.12 0.025"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.025 0.12 0.025"/>
      </geometry>
    </collision>
  </link>
  <joint name="handle_fixed" type="fixed">
    <parent link="drawer"/>
    <child link="handle"/>
    <origin xyz="-0.04 0 0"/>
  </joint>
</robot>
